# Copy to .env next to docker-compose.yml and adjust as needed.
# The dashboard's one-click update rewrites JUSTDNS_TAG in this file.

# The running version. "latest" on first install; the updater pins the exact
# release tag (e.g. v0.10.0) here after an update.
JUSTDNS_TAG=latest

# The JustDNS image repository (without a tag). The public default is the GitHub
# Container Registry; point it at your own registry to self-host.
JUSTDNS_IMAGE=ghcr.io/bonderaustriaat/justdns

# The updater sidecar image. Version-neutral; :latest is fine.
JUSTDNS_UPDATER_IMAGE=ghcr.io/bonderaustriaat/justdns-updater
JUSTDNS_UPDATER_TAG=latest

# Optional: Prometheus scrape token. Set a value to enable GET /metrics; leave it
# out to keep the endpoint off. Kept here so it survives a one-click update.
# JUSTDNS_METRICS_TOKEN=change-me

# Optional: high availability (two-node sync). You normally set this up through the
# dashboard (High availability page) instead, but the shared key can be pinned here —
# it must be identical on both nodes. See docs/guides/high-availability.md.
# JUSTDNS_SYNC_KEY=a-long-random-shared-secret
# JUSTDNS_NODE_ID=                       # auto-generated and persisted if left unset
# JUSTDNS_SYNC_INTERVAL=30               # seconds between sync cycles (minimum 5)
